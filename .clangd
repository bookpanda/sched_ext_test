# sched_ext headers come from the course kernel. -isystem keeps diagnostics
# in that tree out of this repo. Do not define LSP: common.bpf.h would then
# include ../vmlinux.h, which is not where the kernel generates it.
CompileFlags:
  Add:
    - -isystem../linux/tools/sched_ext/include
    - -isystem../linux/tools/sched_ext/include/bpf-compat
    - -isystem../linux/tools/sched_ext/build/include
    - -isystem../linux/tools/include/uapi
    - -isystem../linux/include
    - -Isimple/build
    - -Wno-unknown-attributes
    - -Wno-unused-function
---
If:
  PathMatch: .*\.bpf\.c
CompileFlags:
  Add:
    - -xc
    - -D__TARGET_ARCH_x86
    - -D__BPF_TRACING__
    - -target
    - bpf
---
If:
  PathMatch: .*/linux/.*
Diagnostics:
  Suppress: "*"
Index:
  Background: Skip
